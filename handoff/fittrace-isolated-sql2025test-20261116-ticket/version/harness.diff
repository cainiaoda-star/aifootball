+    private async Task WriteSaveMilkEvidenceAsync(string testName, MilkSaveOutcome? outcome, string? already = null)
+    {
+        var sb = new StringBuilder();
+        sb.Append("test=").Append(testName);
+        if (outcome is null)
+        {
+            sb.Append(" outcome=none");
+        }
+        else
+        {
+            sb.Append(" run=").Append(outcome.RunId);
+            sb.Append(" kind=").Append(outcome.Kind);
+            sb.Append(" published=").Append(outcome.Published);
+            sb.Append(" reason=").Append(outcome.Reason);
+            sb.Append(" outcomePickRows=").Append(outcome.PickRows);
+        }
+        if (!string.IsNullOrEmpty(already))
+            sb.Append(" | ").Append(already);
+
+        if (!string.IsNullOrEmpty(outcome?.RunId))
+        {
+            await using var conn = await _db.Factory.OpenAsync();
+            var runId = outcome.RunId;
+            async Task<long> Count(string sql) =>
+                await FitTraceDbFixture.Scalar(conn, sql, new SqlParameter("@run", runId));
+            var runRows = await Count("SELECT COUNT(*) FROM dbo.FbMilkRun WHERE RunId=@run");
+            var success = await Count("SELECT COUNT(*) FROM dbo.FbMilkRun WHERE RunId=@run AND Status=N'success'");
+            var picks = await Count("SELECT COUNT(*) FROM dbo.FbMilkPick WHERE RunId=@run");
+            var listed = await Count("SELECT COALESCE((SELECT SUM(PickCount) FROM dbo.FbMilkRunDate WHERE RunId=@run), 0)");
+            var bound = await Count("SELECT COALESCE((SELECT ModelFitInstanceId FROM dbo.FbMilkRun WHERE RunId=@run), 0)");
+            var status = "";
+            if (runRows > 0)
+            {
+                await using var cmd = new SqlCommand(
+                    "SELECT Status FROM dbo.FbMilkRun WHERE RunId=@run", conn) { CommandTimeout = 30 };
+                cmd.Parameters.Add(new SqlParameter("@run", runId));
+                var value = await cmd.ExecuteScalarAsync();
+                status = value is null or DBNull ? "" : Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
+            }
+            sb.Append(" | beforeCleanup runRows=").Append(runRows);
+            sb.Append(" status=").Append(status);
+            sb.Append(" successRows=").Append(success);
+            sb.Append(" pickRows=").Append(picks);
+            sb.Append(" pickCount=").Append(listed);
+            sb.Append(" modelFitInstanceId=").Append(bound);
+        }
+
+        var line = sb.ToString();
+        _output.WriteLine(line);
+        var path = Path.Combine(Directory.GetCurrentDirectory(), "fittrace-savemilk-evidence.txt");
+        await File.AppendAllTextAsync(path, line + Environment.NewLine);
+    }
