<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AiFootBall.Core\AiFootBall.Core.csproj" />
    <InternalsVisibleTo Include="AiFootBall.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <!-- 数据库脚本以嵌入资源方式随程序集发布，运行时可自动建库 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\*.sql" LogicalName="Sql.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
