# Repo root moved up to the project root on 2026-11-09 so that tools/, deploy
# scripts, docs and work logs get versioned too. Previously the root was
# source/aifootball, which left every ops script without any backup.
# Rules below are relative to THIS directory. source/aifootball/.gitignore still
# applies to that subtree (build output, appsettings, secrets).

# ===== build output =====
bin/
obj/
node_modules/
_run/
.vs/
*.user

# ===== credentials: NEVER track =====
# appsettings.json holds the SQL password; secrets/ holds the 500.com cookie.
**/appsettings.json
secrets/
tools/db-credential.ps1
_probe/

# ===== production artifacts / large files =====
# deploy-package ~596MB, db-backup ~120MB: local only, backed up separately.
deploy-package/
db-backup/
production-data/
temp/
*.log
*.err
*.bak

# ===== WorkBuddy: keep the memory logs, drop scratch =====
.workbuddy/*
!.workbuddy/memory/

# ===== ad-hoc debug dumps at root =====
/picks.json
/today.json
/show.json
/bd06b.txt
